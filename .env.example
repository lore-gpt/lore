# This file is ONLY for running the `lore` binary directly on your host
# (`lore serve` / `lore worker`). It is a template — copy it to .env and adjust.
#
# `task compose:up` (the Docker quickstart) does NOT read this file. Docker
# Compose sets its own values in infra/docker-compose.yml, where the services
# reach Postgres at the container hostname `paradedb` (not localhost). So a Docker
# install needs no changes here — leave this file alone unless you run the binary
# outside Compose.
#
# The localhost values below assume YOU provide the dependencies on your host
# (e.g. your own Postgres/ParadeDB listening on :5432). Point them at wherever
# yours actually run.

# Postgres (ParadeDB) connection string. Required.
# Direct-run value targets a DB on your host. (Compose instead uses the service
# hostname: postgres://lore:lore@paradedb:5432/lore?sslmode=disable)
LORE_DATABASE_URL=postgres://lore:lore@localhost:5432/lore?sslmode=disable

# API keys are NOT an env var. Mint one per project with `lore keys create
# --project <id>` (it prints the token once); the server authenticates the
# bearer token against the api_keys table. Revoke with `lore keys revoke <id>`.

# HTTP listen address. Optional (default :8080).
LORE_ADDR=:8080

# Valkey URL for the working-memory cache. Optional, and nothing a caller can see
# depends on it: a state fact is stored durably in the same transaction as the
# event carrying it, and the context pack serves its working section from there.
# When unset the cache is disabled; an unreachable server degrades (non-fatal);
# a malformed URL fails the boot.
# If you do set it, set it for BOTH `serve` and `worker`: serve writes a state
# fact through on the request path and the worker re-emits it on the consolidation
# pass, so a cache only one of them can see is half-wired — and /healthz reports
# serve's view, so the worker's half would look healthy while doing nothing.
LORE_VALKEY_URL=redis://localhost:6379

# Max bytes for a working-memory (kind:"state") fact's value, enforced at
# ingestion. Optional; 0/unset uses the built-in default (8 KiB).
LORE_WORKMEM_MAX_VALUE_BYTES=8192

# How long the dense retrieval leg may take to produce a query embedding before
# the read proceeds without it (Go duration; unset/invalid uses the built-in 2s).
# The budget exists to cap tail latency when the embedding provider is slow — but
# set it below your provider's real latency and the dense leg is dropped on every
# request, so the pack answers from the lexical leg alone and says so in the
# response's `degraded` field.
# LORE_RETRIEVAL_PARTIAL_TIMEOUT=2s

# --- Observability ---
# Prometheus /metrics is ON by default. BOTH serve and worker expose it on
# LORE_METRICS_ADDR, on a listener separate from the API port — that is what lets
# you publish the API without publishing this. The endpoint is UNAUTHENTICATED,
# like /healthz, so keep it off the public network. It binds every interface as
# written below; on bare metal use a firewall rule or a specific bind address
# (e.g. 127.0.0.1:9090). Under compose there is nothing to do — neither service
# publishes this port. Running serve and worker on ONE host means giving one of
# them a different address here; under compose they are separate containers.
# LORE_METRICS_ENABLED=true
# LORE_METRICS_ADDR=:9090
# OpenTelemetry traces are OFF by default. Set LORE_OTEL_ENABLED=true AND an OTLP
# endpoint to export them (any OTLP/HTTP collector); enabling without an endpoint
# stays a silent no-op. Spans carry counts and ids only — never memory content or
# query text. All standard OTEL_EXPORTER_OTLP_* variables are honoured.
# LORE_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Extraction (worker only) ---
# Read by `lore worker`, not by `lore serve` — extraction runs on the consolidation
# pass, so these three belong to the worker's environment.
# The worker distills events into memories. Unset (or =fixture) uses an offline,
# deterministic fixture extractor (no external API). For real LLM extraction set
# the provider to `anthropic`, which additionally requires ANTHROPIC_API_KEY (a
# provider-native key, deliberately NOT LORE_-prefixed) or the worker fails loudly
# at boot. An unknown provider is a startup error.
# LORE_EXTRACTION_PROVIDER=anthropic
# Optional model override; unset uses the provider's built-in default.
# LORE_EXTRACTION_MODEL=
# ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings (semantic recall) ---
# Retrieval embeds each memory and each query. Unset (or =fixture) uses an
# offline, deterministic fixture embedder: reproducible, but NOT a semantic
# vector space. For real recall, set the provider to `openai` and point it at any
# OpenAI-compatible /v1/embeddings endpoint (OpenAI, or a self-hosted
# TEI/Ollama/vLLM server). Set the SAME values for both `lore serve` and `lore
# worker`, or the query and the stored vectors land in different spaces and
# retrieval returns nothing.
# LORE_EMBEDDING_PROVIDER=openai
# LORE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# LORE_EMBEDDING_MODEL=text-embedding-3-small
# The vector dimension. Asserted against every response, so a wrong model/dim
# fails loud. Changing it later opens a NEW vector space — an existing project
# would need a re-embedding migration.
# LORE_EMBEDDING_DIM=1536
# Send the `dimensions` request field (OpenAI-family truncation). Leave off for a
# self-hosted server that rejects an unknown field; the length assert is the
# contract either way.
# LORE_EMBEDDING_SEND_DIMENSIONS=false
# Bearer token for the endpoint. Omit for a self-hosted server that needs none.
# LORE_EMBEDDING_API_KEY=sk-...
